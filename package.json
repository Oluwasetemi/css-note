{
  "name": "css-note",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "pnpx playwright install chromium",
    "build": "slidev build",
    "dev": "nodemon -w '../../packages/slidev/dist/*.mjs' --exec \"slidev ./slides.md --open=false --log=info --inspect\"",
    "export": "slidev export",
    "export:pdf": "pnpm run export -- --timeout 160000 --format pdf --output ./_export/soe_altschool_cssnote.pdf",
    "export:pptx": "pnpm run export -- --timeout 160000 --with-clicks false --format pptx --output ./_export/soe_altschool_cssnote.pptx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@slidev/cli": "52.15.1",
    "@slidev/client": "52.15.1",
    "@slidev/theme-default": "latest",
    "@vueuse/core": "^14.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.3",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/mdi": "^1.2.3",
    "@slidev/types": "52.15.1",
    "@vue/compiler-sfc": "^3.5.34",
    "markdown-it-magic-link": "^0.1.4",
    "nodemon": "^3.1.14",
    "playwright-chromium": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-slidev": "^1.0.5",
    "vite": "^8.0.13"
  }
}
